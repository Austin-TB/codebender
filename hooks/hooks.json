{
  "description": "workflow: loads the rules at session start, enforces TDD before source edits, and enforces phased plans at plan approval",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/inject_rules.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/tdd_gate.py\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          { "type": "command", "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plan_gate.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
